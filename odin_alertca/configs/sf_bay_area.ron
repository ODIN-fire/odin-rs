// example RON config file for AlertCalifornia cameras in the SF Bay Area
AlertCaConfig(
    // cameras are either plain AlertCalifornia ids or (id: "..", height_above_ground: <m>, tilt_offset: <deg>) structs
    // with local camera attributes (both optional)
    cameras: [
        "limekilncanyon-cam01", //"Axis-LimekilnCanyon",
        "pressonhill-cam01", // "Axis-PressonHill1",
        "pressonhill-cam02", //"Axis-PressonHill2",
        (id: "mtchual-cam01", height_above_ground: 12.0), // "Axis-MtChaul", // NOTE: mis-spelled. Should be "MtChual"
        (id: "lomaprieta-cam01", height_above_ground: 14.0), // "Axis-LomaPrieta",
        "mtrodoni-cam01", // "Axis-MtRodoni1",
        "mtbielawski-cam01", // "Axis-MtBielawski",
        "almaden-cam01", // "Axis-Almaden1",
        "almaden-cam02", // "Axis-Almaden2",
        "bonnydoon-cam01", // "Axis-BonnyDoon",
        "eaglerocklookout-cam01", //"Axis-EagleRockLookout2",
        "eaglerocklookout-cam02",
        "chalkmtnlookout-cam01", // "Axis-ChalkMtnLookout",
        "castanearidge-cam01", // "Axis-CastaneaRidge",
        "cupertinohills-cam01", // "Axis-CupertinoHills",
        "blackmtscc-cam01", // "Axis-BlackMtSCC",
        "blackmtscc-cam02", // "Axis-BlackMtSCC2",
        "montebellopreserve-cam01", // "Axis-MontebelloPreserve",
        "foothillspark-cam01", // "Axis-FoothillsPark",
        "jasperridge-cam01", // "Axis-JasperRidge",
        "allenpeak-cam01", // "Axis-AllenPeak",
        "tunitas-cam01", // "Axis-Tunitas",
        "higginscanyon-cam01", // "Axis-HigginsCanyon",
        "scottsvalley-cam01", // "Axis-Weston1", // (Scotts Valley)
        "brookdale-cam01", // "Axis-Brookdale",
        "mtmadonna-cam01", // "Axis-MtMadonna",
        "holidaylake-cam01", // "Axis-HolidayLake1",
        "holidaylake-cam02", // "Axis-HolidayLake2",
        "starrcanyon-cam01", // "Axis-StarrCanyon1",
        "starrcanyon-cam02", // "Axis-StarrCanyon2",
        "mthamiltonscc-cam01", // "Axis-MtHamiltonSCC1",
        "mthamiltonscc-cam02", // "Axis-MtHamiltonSCC2",
        "mthamiltonscc-cam03", // "Axis-MtHamiltonSCC3",
        "miliasranch-cam01", // "Axis-MiliasRanch1",
        "miliasranch-cam02", // "Axis-MiliasRanch2",
        "pachecopeak-cam01", // "Axis-PachecoPeak1",
        "pachecopeak-cam02", // "Axis-PachecoPeak2",
    ],
    default_height_above_ground: 10.0, // [m] for cameras without configured height_above_ground

    base_url: "https://cameras.alertcalifornia.org/public-camera-data",

    update_interval: Duration(secs:180,nanos:0), // update every 3 min
    max_history: 10, // number of camera states we keep per camera

    // DEM for server side viewpoint tracking (view ray terrain intersections). Can also be Server("http://<serve_dem-host>:9019")
    dem: Some(File("$ODIN_ROOT/data/odin_dem/3dep13-conus-i16/3dep13-conus-i16.vrt")),
)
